# Copy to /workspace/babybuddy/.env (created automatically by install.sh).
# The file is gitignored and survives git pulls.

SECRET_KEY=change-me-to-a-random-64-char-string
DEBUG=0
ALLOWED_HOSTS=*

# Optional
# SUB_PATH=/babybuddy
# CSRF_TRUSTED_ORIGINS=https://babybuddy.example.com
# SESSION_COOKIE_SECURE=1
# CSRF_COOKIE_SECURE=1
# SECURE_PROXY_SSL_HEADER=1
